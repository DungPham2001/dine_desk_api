NODE_ENV=development
PORT=4000
# Same Atlas cluster as the other apps, one database per app: dinedesk
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/dinedesk?retryWrites=true&w=majority
# Required in production (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
CORS_ORIGINS=
# Fallback timezone (the restaurant has its own shop.timezone)
TIMEZONE=Asia/Ho_Chi_Minh

# Public URL of this API (privacy / account deletion pages)
PUBLIC_BASE_URL=

# true = anyone can register an admin (review only). Default: register works only while there is no admin.
REGISTRATION_OPEN=false

# App version gate (GET /v1/health, header X-App-Version -> 426 when older than MIN_APP_VERSION)
MIN_APP_VERSION=1.0.0
LATEST_APP_VERSION=1.0.0

# Sessions: access token 2h, refresh sliding 3h, absolute 24h
ACCESS_TOKEN_MINUTES=120
REFRESH_IDLE_MINUTES=180
SESSION_MAX_HOURS=24
MAX_SESSIONS_PER_ACCOUNT=10

# Password reset email (Gmail App Password, not the Gmail password). Empty SMTP_HOST outside production returns the code as devToken.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DineDesk <no-reply@example.com>
RESET_CODE_MINUTES=30

# Privacy page owner/contact
PRIVACY_OWNER=DineDesk
PRIVACY_EMAIL=

# Per-IP limits. RATE_LIMIT=off disables them.
RATE_READ_PER_MIN=600
RATE_WRITE_PER_MIN=180
RATE_AUTH_PER_MIN=10
RATE_REGISTER_PER_HOUR=5
# 5 wrong passwords lock that email for 15 minutes
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
